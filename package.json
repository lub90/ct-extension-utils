{
    "name": "ct-extension-utils",
    "version": "0.1.0",
    "description": "Vue design system (components, composables, theme) for ChurchTools extensions. Source only.",
    "license": "MIT",
    "type": "module",
    "files": ["src"],
    "exports": {
        ".": "./src/index.ts",
        "./theme.css": "./src/theme.css",
